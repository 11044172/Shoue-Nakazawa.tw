---
import { type CollectionEntry } from "astro:content";
import { type Lang, t, ui, withBase } from "../utils/i18n";
const { project, lang } = Astro.props as { project: CollectionEntry<"projects">; lang: Lang };
const u = ui[lang];
---
<article class="project-card">
  {project.data.image && <img src={withBase(project.data.image)} alt={t(project.data.imageAlt, lang)} width="800" height="500" loading="lazy" decoding="async" />}
  <div class="project-card-body">
    <div class="card-meta"><span>{t(project.data.status, lang)}</span>{project.data.featured && <span>Featured</span>}</div>
    <h3><a href={withBase(`${lang}/projects/${project.data.slug}/`)}>{t(project.data.title, lang)}</a></h3>
    <p>{t(project.data.summary, lang)}</p>
    <ul class="tag-list" aria-label={u.technology}>
      {project.data.tags.slice(0, 6).map((tag) => <li>{tag}</li>)}
    </ul>
    <a class="text-link" href={withBase(`${lang}/projects/${project.data.slug}/`)}>{u.viewProjects}<span aria-hidden="true"> ↗</span></a>
  </div>
</article>
