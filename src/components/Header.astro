---
import { languages, type Lang, ui, withBase } from "../utils/i18n";
const { lang, currentPath = "" } = Astro.props as { lang: Lang; currentPath?: string };
const u = ui[lang];
const home = withBase(`${lang}/`);
const nav = [
  [u.profile, `${home}#profile`],
  [u.experience, `${home}#experience`],
  [u.projects, withBase(`${lang}/projects/`)],
  [u.story, withBase(`${lang}/story/`)],
  [u.contact, withBase(`${lang}/contact/`)]
];
const languageLabels = { ja: "日本語", "zh-tw": "繁體中文", en: "English" };
const translatedPath = (target: Lang) => {
  const rest = currentPath.replace(/^\/?(ja|zh-tw|en)\/?/, "");
  return withBase(`${target}/${rest}`);
};
---
<a class="skip-link" href="#main">{u.skip}</a>
<header class="site-header" data-header>
  <div class="header-inner">
    <a class="brand" href={home} aria-label="Shoue Nakazawa home">
      <span class="brand-mark">SN</span>
      <span>Shoue Nakazawa</span>
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="sr-only">{u.menu}</span><span aria-hidden="true"></span><span aria-hidden="true"></span>
    </button>
    <nav id="site-nav" class="site-nav" aria-label="Primary">
      {nav.map(([label, href]) => {
        const section = href.includes("#") ? href.split("#")[1] : "";
        const pagePart = href.split("/").filter(Boolean).at(-1) || "";
        const current = section ? undefined : currentPath.includes(`/${pagePart}/`) ? "page" : undefined;
        return <a href={href} data-nav-section={section || undefined} aria-current={current}>{label}</a>;
      })}
      <div class="header-actions">
        <label class="language-select">
          <span class="sr-only">Language</span>
          <select data-language-select aria-label="Language">
            {languages.map((code) => <option value={translatedPath(code)} selected={code === lang}>{languageLabels[code]}</option>)}
          </select>
        </label>
        <button class="theme-toggle" type="button" aria-label={u.theme} title={u.theme}>
          <span class="theme-icon" aria-hidden="true">◐</span>
        </button>
      </div>
    </nav>
  </div>
</header>
<script is:inline>
  (() => {
    const root = document.documentElement;
    const saved = localStorage.getItem("theme");
    if (saved === "dark" || saved === "light") root.dataset.theme = saved;
    const menu = document.querySelector(".menu-toggle");
    const nav = document.querySelector("#site-nav");
    let previousFocus = null;
    const setMenu = (open) => {
      if (!(menu instanceof HTMLElement) || !(nav instanceof HTMLElement)) return;
      menu.setAttribute("aria-expanded", String(open));
      nav.classList.toggle("is-open", open);
      document.body.classList.toggle("menu-open", open);
      if (open) {
        previousFocus = document.activeElement;
        nav.querySelector("a,button,select")?.focus();
      } else if (previousFocus instanceof HTMLElement) {
        previousFocus.focus();
      }
    };
    menu?.addEventListener("click", () => setMenu(menu.getAttribute("aria-expanded") !== "true"));
    nav?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => {
      if (menu?.getAttribute("aria-expanded") === "true") setMenu(false);
    }));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu?.getAttribute("aria-expanded") === "true") setMenu(false);
      if (event.key !== "Tab" || menu?.getAttribute("aria-expanded") !== "true" || !(nav instanceof HTMLElement)) return;
      const focusable = [...nav.querySelectorAll("a,button,select")].filter((item) => item instanceof HTMLElement && !item.hasAttribute("disabled"));
      if (!focusable.length) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
      if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
    });
    document.querySelector(".theme-toggle")?.addEventListener("click", () => {
      const systemDark = matchMedia("(prefers-color-scheme: dark)").matches;
      const current = root.dataset.theme || (systemDark ? "dark" : "light");
      const next = current === "dark" ? "light" : "dark";
      root.dataset.theme = next;
      localStorage.setItem("theme", next);
    });
    document.querySelector("[data-language-select]")?.addEventListener("change", (event) => {
      const target = event.currentTarget;
      if (target instanceof HTMLSelectElement) location.href = target.value;
    });
    const sectionLinks = [...document.querySelectorAll("[data-nav-section]")];
    const sections = sectionLinks.map((link) => document.getElementById(link.dataset.navSection)).filter(Boolean);
    if (sections.length) {
      const observer = new IntersectionObserver((entries) => {
        const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (!visible) return;
        sectionLinks.forEach((link) => link.toggleAttribute("data-active", link.dataset.navSection === visible.target.id));
      }, { rootMargin: "-25% 0px -60% 0px", threshold: [0, .2, .5] });
      sections.forEach((section) => observer.observe(section));
    }
  })();
</script>
