---
import BaseLayout from "../../layouts/BaseLayout.astro";
import socialLinks from "../../data/social-links.json";
import profile from "../../data/profile.json";
import { languages, type Lang, ui, withBase } from "../../utils/i18n";
export function getStaticPaths(){return languages.map((lang)=>({params:{lang}}));}
const lang=Astro.params.lang as Lang; const u=ui[lang];
const links=socialLinks.filter((item)=>item.published&&item.url);
---
<BaseLayout {lang} title={`${u.contact} | Shoue Nakazawa`}>
  <header class="page-hero container"><p class="eyebrow">CONTACT</p><h1>Let’s connect.</h1><p>{u.contactLead}</p></header>
  <section class="section"><div class="container card-grid">{links.map((item)=><article class="content-card"><h2 style="font-size:2rem">{item.label}</h2><a class="text-link" href={item.url} target={item.url.startsWith("http")?"_blank":undefined} rel={item.url.startsWith("http")?"noopener noreferrer":undefined}>{item.url.startsWith("mailto:")?item.url.replace("mailto:",""):item.label} ↗</a></article>)}{profile.cv&&<article class="content-card"><h2 style="font-size:2rem">CV</h2><a class="text-link" href={withBase(profile.cv)}>{u.viewCv}</a></article>}</div></section>
</BaseLayout>
