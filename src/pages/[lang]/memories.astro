---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Lightbox from "../../components/Lightbox.astro";
import { languages, type Lang, t, ui, withBase } from "../../utils/i18n";
export function getStaticPaths(){return languages.map((lang)=>({params:{lang}}));}
const lang=Astro.params.lang as Lang; const u=ui[lang];
const memories=(await getCollection("memories",({data})=>data.published&&data.showInGallery)).sort((a,b)=>a.data.order-b.data.order);
const categories=[...new Set(memories.map((item)=>item.data.category))];
---
<BaseLayout {lang} title={`${u.memories} | Shoue Nakazawa`} description={u.memoriesLead}>
  <header class="page-hero container"><p class="eyebrow">Memories / Gallery</p><h1>{u.memories}</h1><p>{u.memoriesLead}</p></header>
  <section class="section"><div class="container">
    <div class="filter-bar" aria-label="Memory filters"><button class="filter-button" type="button" data-memory-filter="all" aria-pressed="true">{u.filterAll}</button>{categories.map((category)=><button class="filter-button" type="button" data-memory-filter={category} aria-pressed="false">{category}</button>)}</div>
    <div class="memory-grid">
      {memories.map((item)=><button class="memory-item" type="button" data-memory-category={item.data.category} data-lightbox data-src={withBase(item.data.image||"")} data-alt={t(item.data.imageAlt,lang)} data-caption={t(item.data.caption,lang)}>
        <img src={withBase(item.data.image||"")} alt={t(item.data.imageAlt,lang)} width="800" height="600" loading="lazy" decoding="async"/>
        <div><strong>{t(item.data.title,lang)}</strong><small>{item.data.year}{t(item.data.place,lang)?` · ${t(item.data.place,lang)}`:""}</small></div>
      </button>)}
    </div>
  </div></section>
  <Lightbox {lang}/>
</BaseLayout>
<script>
  const buttons=[...document.querySelectorAll<HTMLButtonElement>("[data-memory-filter]")];
  const items=[...document.querySelectorAll<HTMLElement>("[data-memory-category]")];
  buttons.forEach((button)=>button.addEventListener("click",()=>{
    const value=button.dataset.memoryFilter||"all";
    buttons.forEach((b)=>b.setAttribute("aria-pressed",String(b===button)));
    items.forEach((item)=>item.hidden=value!=="all"&&item.dataset.memoryCategory!==value);
  }));
</script>
