---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import profile from "../../data/profile.json";
import skills from "../../data/skills.json";
import languageData from "../../data/languages.json";
import interests from "../../data/interests.json";
import { languages, type Lang, t, ui, withBase } from "../../utils/i18n";

export function getStaticPaths() { return languages.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const u = ui[lang];
const [experiences, education, projects, achievements] = await Promise.all([
  getCollection("experience", ({ data }) => data.published),
  getCollection("education", ({ data }) => data.published),
  getCollection("projects", ({ data }) => data.published && data.featured),
  getCollection("achievements", ({ data }) => data.published && data.featured)
]);
const featuredExperience = experiences.filter((item) => item.data.featured).sort((a,b)=>a.data.order-b.data.order);
const featuredEducation = education.filter((item) => item.data.featured).sort((a,b)=>a.data.order-b.data.order);
const featuredProjects = projects.sort((a,b)=>a.data.order-b.data.order);
const featuredAchievements = achievements.sort((a,b)=>a.data.order-b.data.order).slice(0,4);
---
<BaseLayout {lang}>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Semiconductor · Web · AI</p>
        <h1><span class="hero-name-ja">中澤祥慧</span><span>Shoue</span><span>Nakazawa</span></h1>
        <p class="hero-tagline">{t(profile.tagline, lang)}</p>
        <p class="hero-copy">{t(profile.intro, lang)}</p>
        <ul class="role-list">{profile.roles[lang === "zh-tw" ? "zhTw" : lang].map((role) => <li>{role}</li>)}</ul>
        <div class="button-row">
          <a class="button" href={withBase(`${lang}/projects/`)}>{u.viewProjects}</a>
          <a class="button secondary" href={withBase(`${lang}/story/`)}>{u.viewStory}</a>
          {profile.cv && <a class="button ghost" href={withBase(profile.cv)}>{u.viewCv}</a>}
          <a class="button ghost" href={withBase(`${lang}/contact/`)}>{u.contactMe}</a>
        </div>
        <div class="hero-stats" aria-label="Focus">
          <div><strong>WET / Cleaning</strong><span>Semiconductor</span></div>
          <div><strong>Web & AI</strong><span>Product Development</span></div>
          <div><strong>日本語・中文</strong><span>Japan × Taiwan</span></div>
        </div>
      </div>
      <figure class="hero-portrait">
        <img src={withBase(profile.heroImage)} alt={t(profile.heroImageAlt, lang)} width="756" height="1008" fetchpriority="high" decoding="async" />
      </figure>
    </div>
  </section>

  <section class="section section-tinted" id="about">
    <div class="container about-grid">
      <SectionHeading eyebrow="01 / About" title={u.about} description={t(profile.intro, lang)} />
      <ul class="keyword-cloud">{profile.keywords.map((keyword) => <li>{keyword}</li>)}</ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading eyebrow="02 / Current Status" title={`${u.current} → ${u.next}`} />
      <div class="status-grid">
        <article class="status-card">
          <p class="eyebrow">{u.current}</p><p class="period">{profile.current.period}</p>
          <h3>{profile.current.organization}</h3><p>{profile.current.role}<br />{profile.current.field}</p>
        </article>
        <article class="status-card next">
          <p class="eyebrow">{u.next}</p><p class="period">{profile.next.period}</p>
          <h3>{t(profile.next.organization, lang)}</h3><p>{t(profile.next.program, lang)}</p>
          <ul class="tag-list">{profile.next.interests.map((item) => <li>{item}</li>)}</ul>
        </article>
      </div>
    </div>
  </section>

  <section class="section section-tinted" id="experience">
    <div class="container">
      <SectionHeading eyebrow="03 / Experience" title={u.experience} />
      <div class="card-grid">
        {featuredExperience.map((item) => <article class="content-card">
          <span class="date">{item.data.startDate} — {item.data.endDate || "Now"}</span>
          <h3>{t(item.data.organization, lang)}</h3><p><strong>{t(item.data.role, lang)}</strong></p>
          <p>{t(item.data.summary, lang)}</p><ul class="tag-list">{item.data.tags.slice(0,7).map((tag)=><li>{tag}</li>)}</ul>
        </article>)}
      </div>
    </div>
  </section>

  <section class="section" id="education">
    <div class="container">
      <SectionHeading eyebrow="04 / Education" title={u.education} />
      <div class="card-grid">
        {featuredEducation.map((item) => <article class="content-card">
          {item.data.image && <img src={withBase(item.data.image)} alt={t(item.data.imageAlt, lang)} width="600" height="338" loading="lazy" />}
          <span class="date">{item.data.startDate} — {item.data.endDate || "Now"}</span>
          <h3>{t(item.data.school, lang)}</h3><p><strong>{t(item.data.program, lang)}</strong></p><p>{t(item.data.summary, lang)}</p>
        </article>)}
      </div>
    </div>
  </section>

  <section class="section section-tinted" id="projects">
    <div class="container">
      <SectionHeading eyebrow="05 / Selected Projects" title={`${u.selected} ${u.projects}`} />
      <div class="project-grid">{featuredProjects.map((project) => <ProjectCard {project} {lang} />)}</div>
      <div class="button-row"><a class="button secondary" href={withBase(`${lang}/projects/`)}>{u.viewAll}</a></div>
    </div>
  </section>

  <section class="section" id="skills">
    <div class="container">
      <SectionHeading eyebrow="06 / Capabilities" title={u.skills} />
      <div class="skills-grid">{skills.map((group)=><article class="skill-group"><h3>{group.category}</h3><ul class="skill-list">{group.items.map((item)=><li><span>{item.name}</span><small>{item.context}</small></li>)}</ul></article>)}</div>
    </div>
  </section>

  <section class="section section-tinted">
    <div class="container">
      <SectionHeading eyebrow="07 / Languages" title="Languages" />
      <div class="language-grid">{languageData.map((item)=><article class="language-card"><h3>{t(item.name, lang)}</h3><p>{t(item.level, lang)}</p></article>)}</div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading eyebrow="08 / Achievements" title={`${u.selected} ${u.achievements}`} />
      <div class="card-grid">{featuredAchievements.map((item)=><article class="content-card"><span class="date">{item.data.year}</span><h3>{t(item.data.title, lang)}</h3><p>{t(item.data.summary, lang)}</p></article>)}</div>
      <div class="button-row"><a class="button secondary" href={withBase(`${lang}/achievements/`)}>{u.viewAll}</a></div>
    </div>
  </section>

  <section class="section section-warm">
    <div class="container story-promo">
      <div><p class="eyebrow">09 / Personal Life Archive</p><h2>{u.story}</h2><p class="section-description">{u.archiveLead}</p><div class="button-row"><a class="button" href={withBase(`${lang}/story/`)}>{u.viewStory}</a><a class="button secondary" href={withBase(`${lang}/memories/`)}>{u.memories}</a></div></div>
      <div class="story-promo-image"><img src={withBase("/assets/images/memories/taiwan-life.jpg")} alt={lang === "en" ? "A personal memory from life in Taiwan" : lang === "zh-tw" ? "台灣生活的個人回憶" : "台湾生活の思い出"} width="756" height="1008" loading="lazy" /></div>
    </div>
  </section>

  <section class="section">
    <div class="container"><SectionHeading eyebrow="10 / Interests" title="Beyond work" /><ul class="keyword-cloud">{interests.filter((x)=>x.published).map((item)=><li>{item.name}</li>)}</ul></div>
  </section>
</BaseLayout>
