---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Lightbox from "../../components/Lightbox.astro";
import { languages, type Lang, t, ui, withBase } from "../../utils/i18n";
export function getStaticPaths(){return languages.map((lang)=>({params:{lang}}));}
const lang=Astro.params.lang as Lang; const u=ui[lang];
const items=(await getCollection("achievements",({data})=>data.published)).sort((a,b)=>a.data.order-b.data.order);
---
<BaseLayout {lang} title={`${u.achievements} | Shoue Nakazawa`}>
  <header class="page-hero container"><p class="eyebrow">QUALIFICATIONS · SPORTS · MUSIC · LEADERSHIP</p><h1>{u.achievements}</h1><p>{lang==="en"?"A record of achievements shaped through sport, music, discipline, and leadership.":lang==="zh-tw"?"記錄透過運動、音樂、自律與領導經驗累積的成果。":"スポーツ、音楽、継続、リーダー経験を通して積み重ねた実績の記録です。"}</p></header>
  <section class="section"><div class="container card-grid">
    {items.map((item)=><article class="content-card">
      {item.data.image&&<button class="memory-item" type="button" aria-label={`${u.certificates}: ${t(item.data.title,lang)}`} data-lightbox data-src={withBase(item.data.image)} data-alt={t(item.data.imageAlt,lang)} data-caption={t(item.data.title,lang)}><img src={withBase(item.data.image)} alt={t(item.data.imageAlt,lang)} width="600" height="800" loading="lazy"/><span class="certificate-label">{u.certificates}</span></button>}
      <span class="date">{item.data.year} · {item.data.category}</span><h2 style="font-size:clamp(1.3rem,2.5vw,2rem)">{t(item.data.title,lang)}</h2><p>{t(item.data.summary,lang)}</p>
    </article>)}
  </div></section>
  <Lightbox {lang}/>
</BaseLayout>
